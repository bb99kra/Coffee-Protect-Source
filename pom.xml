<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>me.nik</groupId>
        <artifactId>CoffeeProtect</artifactId>
        <version>2.5.6</version>
    </parent>

    <artifactId>plugin</artifactId>

    <repositories>

        <repository>
            <id>jitpack.io</id>
            <url>https://www.jitpack.io</url>
        </repository>

        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>

        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>

        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>

        <repository>
            <id>bungeecord-repo</id>
            <url>https://oss.sonatype.org/content/repositories/snapshots</url>
        </repository>

        <repository>
            <id>viaversion-repo</id>
            <url>https://repo.viaversion.com</url>
        </repository>

        <repository>
            <id>arim-mvn-lgpl3</id>
            <url>https://mvn-repo.arim.space/lesser-gpl3/</url>
        </repository>

        <repository>
            <id>codemc-releases</id>
            <url>https://repo.codemc.io/repository/maven-releases/</url>
        </repository>
        <repository>
            <id>codemc-snapshots</id>
            <url>https://repo.codemc.io/repository/maven-snapshots/</url>
        </repository>

    </repositories>

    <dependencies>

        <dependency>
            <groupId>me.nik</groupId>
            <artifactId>coffeeprotect-api</artifactId>
            <version>${project.version}</version>
            <type>jar</type>
            <scope>compile</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.github.NikV2</groupId>
            <artifactId>packetevents</artifactId>
            <version>2.0-SNAPSHOT</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-api</artifactId>
            <version>4.25.0</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.24.3</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>dev.folia</groupId>
            <artifactId>folia-api</artifactId>
            <version>1.20.4-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>26.1.2-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>net.md-5</groupId>
            <artifactId>bungeecord-api</artifactId>
            <version>1.21-R0.3-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <finalName>${project.parent.name}</finalName>
        <defaultGoal>clean install package</defaultGoal>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>

                            <artifactSet>
                                <excludes>
                                    <exclude>com.github.NikV2.packetevents:packetevents-fabric</exclude>
                                    <exclude>com.github.NikV2.packetevents:packetevents-fabric-common</exclude>
                                    <exclude>com.github.NikV2.packetevents:packetevents-fabric-intermediary</exclude>
                                    <exclude>com.github.NikV2.packetevents:packetevents-fabric-official</exclude>
                                    <exclude>com.github.NikV2.packetevents:packetevents-velocity</exclude>
                                    <exclude>com.github.NikV2.packetevents:packetevents-sponge</exclude>
                                    <exclude>net.fabricmc:fabric-loader</exclude>
                                    <exclude>io.netty</exclude>
                                    <exclude>assets.mappings</exclude>
                                    <exclude>com.github.NikV2.packetevents:packetevents-bungeecord</exclude>
                                </excludes>
                            </artifactSet>

                            <minimizeJar>false</minimizeJar>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>

                                <relocation>
                                    <pattern>net.kyori.adventure.text</pattern>
                                    <shadedPattern>me.nik.coffeeprotect.io.github.retrooper.packetevents.adventure
                                    </shadedPattern>
                                </relocation>

                                <relocation>
                                    <pattern>net.kyori</pattern>
                                    <shadedPattern>me.nik.coffeeprotect.libs.kyori</shadedPattern>
                                </relocation>

                                <relocation>
                                    <pattern>com.github.retrooper</pattern>
                                    <shadedPattern>me.nik.coffeeprotect<!--.libs-->.com.github.retrooper
                                    </shadedPattern>
                                </relocation>

                                <relocation>
                                    <pattern>io.github.retrooper</pattern>
                                    <shadedPattern>me.nik.coffeeprotect<!--.libs-->.io.github.retrooper
                                    </shadedPattern>
                                </relocation>

                                <relocation>
                                    <pattern>com.google.code.gson</pattern>
                                    <shadedPattern>me.nik.coffeeprotect.libs.gson</shadedPattern>
                                </relocation>

                                <relocation>
                                    <pattern>org.json</pattern>
                                    <shadedPattern>me.nik.coffeeprotect.libs.json</shadedPattern>
                                </relocation>

                                <relocation>
                                    <pattern>org.intellij</pattern>
                                    <shadedPattern>me.nik.coffeeprotect.libs.intellij</shadedPattern>
                                </relocation>

                                <relocation>
                                    <pattern>org.jetbrains</pattern>
                                    <shadedPattern>me.nik.coffeeprotect.libs.jetbrains</shadedPattern>
                                </relocation>

                                <relocation>
                                    <pattern>me.nik:*</pattern>
                                    <shadedPattern>me.nik:*</shadedPattern>
                                </relocation>

                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>